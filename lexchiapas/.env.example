ENVIRONMENT=development

# OpenAI: OBLIGATORIA. Se usa para los EMBEDDINGS (text-embedding-3-large a 1024
# dims, ver ai_config.json embeddings) y como primer LLM de llm.fallback_order
# (gpt-4o-mini). Sin esta clave los embeddings fallan y el bot no responde.
OPENAI_API_KEY=

# Kimi (Moonshot AI, https://platform.moonshot.ai): segundo LLM del fallback.
# Solo acepta temperature=1 (el router lo maneja por entrada) y gasta muchos
# tokens en razonamiento oculto. Si se deja vacia, esa entrada falla y el
# router pasa a la siguiente.
KIMI_API_KEY=

# NVIDIA NIM (build.nvidia.com): reranker (llama-nemotron-rerank) y ultimo
# recurso del fallback de LLM. Sus embeddings y modelos LLM anteriores se
# colgaban o fueron retirados (ver ai_config.json _note_migracion_2026_10_23).
NVIDIA_API_KEY=nvapi-your-key-here

# Otros proveedores de LLM, solo como ultimo recurso en el fallback (ver
# ai_config.json llm.fallback_order). Opcionales: si se dejan vacios, el
# fallback simplemente los omite. XAI_API_KEY tiene credito limitado.
# GEMINI_API_KEY/GROQ_API_KEY existen para cuando esas cuentas esten
# utilizables, hoy no estan en fallback_order.
XAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# PostgreSQL (psycopg v3 dialect, requiere extension pgvector instalada)
# Este proyecto usa PostgreSQL 18 en el puerto 5433 (PostgreSQL 14 sigue activo en 5432, sin usar)
DATABASE_URL=postgresql+psycopg://lexchiapas:lexchiapas_dev@localhost:5433/lexchiapas

# Redis (Celery broker/backend)
REDIS_URL=redis://localhost:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Chat de Telegram (numerico) al que se envian las alertas operativas
# (embeddings caidos, pico de errores) -- ver app/workers/alerting_tasks.py.
# Vacio = alertas desactivadas (solo se loguean). Para obtenerlo: escribe al
# bot y consulta https://api.telegram.org/bot<TOKEN>/getUpdates.
ADMIN_TELEGRAM_CHAT_ID=

# WhatsApp (fase posterior)
WHATSAPP_API_TOKEN=

# Panel admin (gestion de documentos + dashboard de metricas)
ADMIN_API_KEY=
# Firma las cookies de sesion de POST /admin/login. En development, si se deja
# vacio, se reusa ADMIN_API_KEY. FUERA de development es OBLIGATORIA y debe
# ser DISTINTA de ADMIN_API_KEY (reusar la admin key permite forjar sesiones
# offline si se filtra). Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# El frontend (lexchiapas-web) debe usar EXACTAMENTE la misma SECRET_KEY.
SECRET_KEY=

# Origen del frontend Next.js (lexchiapas-web), para habilitar CORS.
# Ejemplo: http://localhost:3000 en desarrollo, https://tu-app.vercel.app en prod.
FRONTEND_ORIGIN=
