ENVIRONMENT=development

# NVIDIA NIM (embeddings + LLM, proveedor principal) - build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here

# Proveedores de LLM adicionales, solo como ultimo recurso en el fallback
# (ver ai_config.json llm.fallback_order). Opcionales: si se dejan vacios,
# el fallback simplemente se detiene despues de los modelos de NVIDIA.
# OPENAI_API_KEY y XAI_API_KEY tienen creditos limitados ($5 c/u) -- no
# poner un modelo caro como primera opcion. GEMINI_API_KEY/GROQ_API_KEY
# existen para cuando esas cuentas esten utilizables, hoy no estan en
# fallback_order.
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# PostgreSQL (psycopg v3 dialect, requiere extension pgvector instalada)
# Este proyecto usa PostgreSQL 18 en el puerto 5433 (PostgreSQL 14 sigue activo en 5432, sin usar)
DATABASE_URL=postgresql+psycopg://lexchiapas:lexchiapas_dev@localhost:5433/lexchiapas

# Redis (Celery broker/backend)
REDIS_URL=redis://localhost:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp (fase posterior)
WHATSAPP_API_TOKEN=

# Panel admin (gestion de documentos + dashboard de metricas)
ADMIN_API_KEY=
# Firma las cookies de sesion de POST /admin/login. Si se deja vacio, se
# reusa ADMIN_API_KEY para firmar (valido para fase 1/uso personal).
SECRET_KEY=

# Origen del frontend Next.js (lexchiapas-web), para habilitar CORS.
# Ejemplo: http://localhost:3000 en desarrollo, https://tu-app.vercel.app en prod.
FRONTEND_ORIGIN=
